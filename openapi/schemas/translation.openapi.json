{
  "openapi": "3.0.4",
  "info": {
    "title": "Rapidata Translation API",
    "description": "The API for the Rapidata Translation service",
    "version": "2026.10.29.0928-2164545"
  },
  "servers": [
    {
      "url": "https://api.rabbitdata.ch/"
    }
  ],
  "paths": {
    "/translation/ensure-english": {
      "post": {
        "tags": [
          "Translation"
        ],
        "summary": "Ensures the provided text is in English, returning a suggested English text when it isn't.",
        "requestBody": {
          "description": "The text to verify.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnsureEnglishEndpoint_Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnsureEnglishEndpoint_Output"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/translation": {
      "post": {
        "tags": [
          "Translation"
        ],
        "summary": "Translates text from one language to another using the specified translator.",
        "requestBody": {
          "description": "The translation request body.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranslateEndpoint_Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslateEndpoint_Output"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  },
